# Live-demo image: CPU torch, ffmpeg for browser-safe H.264, baked sample clip.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        ffmpeg \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-demo.txt /app/requirements-demo.txt
RUN pip install --no-cache-dir -r /app/requirements-demo.txt

COPY pyproject.toml README.md /app/
COPY src /app/src
COPY config /app/config
RUN pip install --no-cache-dir --no-deps -e .

RUN mkdir -p /app/models /app/data/input /app/data/output \
    && curl -fsSL -o /app/models/yolov8n.pt \
        https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n.pt \
    && curl -fsSL -o /app/data/input/traffic.mp4 \
        https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/person-bicycle-car-detection.mp4

EXPOSE 8000
ENV PYTHONUNBUFFERED=1
ENV SMARTCITY_DEMO_WARMUP=1
CMD ["uvicorn", "smartcity_vision.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
